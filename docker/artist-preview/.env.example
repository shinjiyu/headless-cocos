# 复制为 .env 后填写；勿提交 .env
#
# Cursor Agent（Loading / 后续 LLM 路径）
CURSOR_API_KEY=
CURSOR_MODEL=
CURSOR_TIMEOUT_MS=600000
# 无 Key / CLI 失败时是否确定性构建（开发冒烟用）
LOADING_PREVIEW_FALLBACK=0
#
# 对外链接（二维码 / API 返回的 previewUrl）；本地默认即可
# PUBLIC_BASE=http://127.0.0.1:8810
# 公网反代示例：
# PUBLIC_BASE=https://your.domain/psd
#
# 可选：挂载外部 AIWS config.local.json（需同时改 docker-compose volumes）
# AIWS_CONFIG_LOCAL=/absolute/path/to/aiws/config.local.json
# AIWS_CONFIG_LOCAL_IN_CONTAINER=/secrets/aiws-config.local.json
