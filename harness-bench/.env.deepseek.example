# DeepSeek Harness (dsh) — this bakeoff uses PocketCity GLM via dsh-llm-pi-ai
# (see %USERPROFILE%\.dsh\profiles\headless\cordis.patch.yml).
#
# Prefer loading harness-bench/.env.glm (already auto-loaded by run.mjs):
#   OPENAI_API_KEY=...
#   OPENAI_BASE_URL=https://ai.pocketcity.com/v1
#   OPENAI_MODEL=GLM-5.2-FP8
#
# Optional: copy those into this file if you want dsh-only overrides.
# OPENAI_API_KEY=
#
# Headless non-interactive permissions (recommended for matrix):
# DSH_PERMISSION_MODE=danger-full-access
#
# Official DeepSeek route (NOT used when agent-default-model=pocketcity):
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
